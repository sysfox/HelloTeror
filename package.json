{
  "name": "teror-fox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Teror Fox 的个人主页。一页框，一架东西。",
  "author": "Teror Fox",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "pnpm typecheck && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external && esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --outfile=api/[[...route]].js",
    "start": "NODE_ENV=production node dist-server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test server/api.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/qwitcher-grypen": "^5.3.0",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
