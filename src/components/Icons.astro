        d="M10.6 6.2H17.6M10.6 12H15.2M10.6 17.8H16.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path>
    </svg>
  )
}
{
  name === "console" && (
