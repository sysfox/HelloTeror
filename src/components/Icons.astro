}
{
  name === "place" && id === "pan" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 8.2 12 4.5l8 3.7-8 3.7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M4 8.2V16l8 3.7 8-3.7V8.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M12 12v7.6" fill="none" stroke="currentColor" stroke-width="1.7"></path>
