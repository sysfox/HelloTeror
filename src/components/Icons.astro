---
interface Props {
  name:
    | "home"
    | "shelf"
    | "timeline"
    | "console"
    | "sun"
    | "moon"
    | "cloud"
    | "rain"
    | "drop"
    | "wind"
    | "place"
  id?: string
  class?: string
