}
{
  name === "place" && id === "status" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M3.5 12h3.2l2-4.5 3.2 9 2.1-4.5H20.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
        stroke-linecap="round"></path>
    </svg>
  )
}
{
  name === "place" && !["github", "bilibili", "email", "legacy", "pan", "lens", "status"].includes(id) && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M7 4.5h7.2L18 8.2V19a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19V6a1.5 1.5 0 0 1 1-1.5z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"></path>
      <path d="M14 4.6V8h3.4M8.5 12.2h7M8.5 15.4h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
    </svg>
  )
}
