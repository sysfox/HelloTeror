{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2023",
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src", "shared", "astro.config.ts"],
  "exclude": ["dist", "server"]
}
